PORT=3001
HOST=0.0.0.0

# Pooled — для работы приложения (Neon: Connection string → Pooled)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require

# Direct — только для миграций в Docker (без -pooler в хосте)
DIRECT_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/db?sslmode=require

JWT_SECRET=change-me-to-long-random-string

LOGIN_DIRECTOR=director
PASSWORD_DIRECTOR=change-me
LOGIN_WORKER=worker
PASSWORD_WORKER=change-me

# Для Docker + Vercel — origin фронта (можно дублировать из корневого .env)
CORS_ORIGINS=https://your-app.vercel.app
