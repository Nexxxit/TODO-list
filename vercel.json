{
  "installCommand": "npm install --include=dev --prefix server && npm run build --prefix server && npm install --include=dev --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.ts": {
      "excludeFiles": "{server/node_modules/prisma/**,server/node_modules/@prisma/engines/**,server/node_modules/typescript/**,server/node_modules/tsx/**}"
    }
  },
  "rewrites": [
    { "source": "/auth", "destination": "/api" },
    { "source": "/auth/:path*", "destination": "/api" },
    { "source": "/tasks", "destination": "/api" },
    { "source": "/tasks/:path*", "destination": "/api" },
    { "source": "/users", "destination": "/api" },
    { "source": "/users/:path*", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/db-check", "destination": "/api" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
